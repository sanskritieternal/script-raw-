  "chapters": [
    {
      "start_seconds": 0,
      "title": "The question and the limits"
    },
    {
      "start_seconds": 80,
      "title": "Where the operation belongs"
    },
    {
      "start_seconds": 160,
      "title": "Invented scores and weights"
    },
    {
      "start_seconds": 240,
      "title": "Combining values"
    },
    {
      "start_seconds": 320,
      "title": "Masking and normalization"
    },
    {
      "start_seconds": 400,
      "title": "Returning to the architecture"
    },
    {
      "start_seconds": 480,
      "title": "Attention and explanation"
    },
    {
      "start_seconds": 560,
      "title": "Questions to keep"
    }
  ],
  "narration_plan": [
    {
      "cue": 1,
      "planned_scene": 1,
      "duration_seconds": 8,
      "text": "Look at a diagram filled with bright connections. What, exactly, would you need to know before trusting its explanation?",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 2,
      "planned_scene": 2,
      "duration_seconds": 8,
      "text": "Our question is deliberately narrow: how does attention combine information, and where should an explanation of that operation stop?",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 3,
      "planned_scene": 3,
      "duration_seconds": 8,
      "text": "We will use the original Transformer paper, first submitted to arXiv in June two thousand seventeen.",
      "claims": [
        "C001"
      ],
      "visual_claims": []
    },
    {
      "cue": 4,
      "planned_scene": 4,
      "duration_seconds": 8,
      "text": "We will also work through invented numbers. They are teaching materials, never measurements collected from a trained model.",
      "claims": [
        "C011",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 5,
      "planned_scene": 5,
      "duration_seconds": 8,
      "text": "Keep three questions separate: what is being calculated, what system contains that calculation, and what evidence supports an interpretation?",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 6,
      "planned_scene": 6,
      "duration_seconds": 8,
      "text": "A useful explanation should let you inspect the steps. It should also tell you which conclusions those steps cannot establish.",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 7,
      "planned_scene": 7,
      "duration_seconds": 8,
      "text": "Our small example will have three positions, which we will call A, B, and C. The labels carry no word meanings.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 8,
      "planned_scene": 8,
      "duration_seconds": 8,
      "text": "Instead of showing a mysterious machine, we will show supplied inputs, a calculation, and its resulting vector.",
      "claims": [
        "C011",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 9,
      "planned_scene": 9,
      "duration_seconds": 8,
      "text": "Later, we will change which positions are allowed into that calculation. Watch the normalization, rather than just the colored arrows.",
      "claims": [
        "C013"
      ],
      "visual_claims": []
    },
    {
      "cue": 10,
      "planned_scene": 10,
      "duration_seconds": 8,
      "text": "Finally, we will ask why describing an operation and explaining a model's prediction require different kinds of evidence.",
      "claims": [
        "C009",
        "C010"
      ],
      "visual_claims": []
    },
    {
      "cue": 11,
      "planned_scene": 11,
      "duration_seconds": 8,
      "text": "First, locate the operation. The original Transformer has an encoder and a decoder; this is our historical architecture.",
      "claims": [
        "C002"
      ],
      "visual_claims": []
    },
    {
      "cue": 12,
      "planned_scene": 12,
      "duration_seconds": 8,
      "text": "Its attention appears in three settings: encoder self-attention, decoder self-attention, and attention connecting the decoder with the encoder.",
      "claims": [
        "C005"
      ],
      "visual_claims": []
    },
    {
      "cue": 13,
      "planned_scene": 13,
      "duration_seconds": 8,
      "text": "Keep those settings distinct. A rule for one should not quietly become a rule for every part of the diagram.",
      "claims": [
        "C005",
        "C006"
      ],
      "visual_claims": []
    },
    {
      "cue": 14,
      "planned_scene": 14,
      "duration_seconds": 8,
      "text": "For now, isolate one calculation. In scaled dot-product attention, query and key scores are scaled and normalized before values are combined.",
      "claims": [
        "C003"
      ],
      "visual_claims": []
    },
    {
      "cue": 15,
      "planned_scene": 15,
      "duration_seconds": 8,
      "text": "Think of query, key, and value as labels for mathematical roles. Our diagram should preserve those labels throughout the demonstration.",
      "claims": [
        "C003"
      ],
      "visual_claims": []
    },
    {
      "cue": 16,
      "planned_scene": 16,
      "duration_seconds": 8,
      "text": "A score is not the final combined result. Follow each stage rather than treating every highlighted connection as the same quantity.",
      "claims": [
        "C003"
      ],
      "visual_claims": []
    },
    {
      "cue": 17,
      "planned_scene": 17,
      "duration_seconds": 8,
      "text": "The normalization step belongs between scoring and combining. We will make its arithmetic visible rather than hiding it behind an animation.",
      "claims": [
        "C003",
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 18,
      "planned_scene": 18,
      "duration_seconds": 8,
      "text": "Our supplied vectors are already prepared for this operation. We are not demonstrating how a trained model learned them.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 19,
      "planned_scene": 19,
      "duration_seconds": 8,
      "text": "That boundary matters: checking an example's arithmetic cannot tell us which words a real model would connect in a real task.",
      "claims": [
        "C011",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 20,
      "planned_scene": 20,
      "duration_seconds": 8,
      "text": "We can inspect each quantity slowly while keeping the limit clear: this example does not observe an actual model.",
      "claims": [
        "C011",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 21,
      "planned_scene": 21,
      "duration_seconds": 8,
      "text": "Here are invented inputs. The label reminds us that these numbers were chosen for teaching, rather than measured from a model.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 22,
      "planned_scene": 22,
      "duration_seconds": 8,
      "text": "The query is square root of two times natural log of two, followed by zero. The exact expression stays on screen.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 23,
      "planned_scene": 23,
      "duration_seconds": 8,
      "text": "The keys for A, B, and C are one, zero; zero, one; and zero, zero, respectively.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 24,
      "planned_scene": 24,
      "duration_seconds": 8,
      "text": "For each key, take its dot product with the query, then divide by the square root of two.",
      "claims": [
        "C003",
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 25,
      "planned_scene": 25,
      "duration_seconds": 8,
      "text": "The resulting scores are natural log of two, zero, and zero. These are intermediate scores, not the final weights.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 26,
      "planned_scene": 26,
      "duration_seconds": 8,
      "text": "Now exponentiate those scores. For our chosen numbers, the three contributions are two, one, and one.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 27,
      "planned_scene": 27,
      "duration_seconds": 8,
      "text": "Their total is four. Divide each contribution by that total so we can inspect the normalized weights.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 28,
      "planned_scene": 28,
      "duration_seconds": 8,
      "text": "A receives one half. B receives one quarter. C receives one quarter. In this invented example, those weights sum to one.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 29,
      "planned_scene": 29,
      "duration_seconds": 8,
      "text": "Pause on the fractions. The colors should help you follow the calculation, while the labels preserve its exact values.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 30,
      "planned_scene": 30,
      "duration_seconds": 8,
      "text": "Nothing here was discovered by asking a model a question. We selected the inputs so that you could check every step.",
      "claims": [
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 31,
      "planned_scene": 31,
      "duration_seconds": 8,
      "text": "Next come the values. A has the vector two, zero. B has zero, four. C has zero, zero.",
      "claims": [
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 32,
      "planned_scene": 32,
      "duration_seconds": 8,
      "text": "Multiply A's value by its weight of one half. Its contribution to the combined vector is one, zero.",
      "claims": [
        "C011",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 33,
      "planned_scene": 33,
      "duration_seconds": 8,
      "text": "Multiply B's value by one quarter. Its contribution is zero, one. C's weighted contribution remains zero, zero.",
      "claims": [
        "C011",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 34,
      "planned_scene": 34,
      "duration_seconds": 8,
      "text": "Adding these contributions gives the combined vector one, one. The result follows directly from the supplied values and weights.",
      "claims": [
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 35,
      "planned_scene": 35,
      "duration_seconds": 8,
      "text": "This distinction is worth keeping: a weight describes a coefficient in the combination; the combined vector is a different object.",
      "claims": [
        "C003",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 36,
      "planned_scene": 36,
      "duration_seconds": 8,
      "text": "The output is two numbers. Our illustration has neither a prediction head nor a trained network interpreting a sentence.",
      "claims": [
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 37,
      "planned_scene": 37,
      "duration_seconds": 8,
      "text": "Try tracing the result backward on the diagram. Which value contributed to the first coordinate, and which to the second?",
      "claims": [
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 38,
      "planned_scene": 38,
      "duration_seconds": 8,
      "text": "In these invented numbers, A supplies the first coordinate and B supplies the second. The labels make the calculation inspectable.",
      "claims": [
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 39,
      "planned_scene": 39,
      "duration_seconds": 8,
      "text": "You can verify that arithmetic without making a claim about language understanding, conscious attention, or the cause of a model's prediction.",
      "claims": [
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 40,
      "planned_scene": 40,
      "duration_seconds": 8,
      "text": "Now keep the same supplied vectors. We will change the allowed positions and calculate the weights again.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 41,
      "planned_scene": 41,
      "duration_seconds": 8,
      "text": "The original decoder's self-attention masks future positions before softmax. This does not describe every attention setting in the architecture.",
      "claims": [
        "C006"
      ],
      "visual_claims": []
    },
    {
      "cue": 42,
      "planned_scene": 42,
      "duration_seconds": 8,
      "text": "For our separate masking illustration, place the query at B. Allow A and B, and exclude C from the combination.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 43,
      "planned_scene": 43,
      "duration_seconds": 8,
      "text": "The allowed exponential contributions are now two and one. The excluded position contributes zero to their normalization total.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 44,
      "planned_scene": 44,
      "duration_seconds": 8,
      "text": "The total is three. The new weights are two thirds, one third, and zero, in the order A, B, C.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 45,
      "planned_scene": 45,
      "duration_seconds": 8,
      "text": "Notice the important change: we normalized again over allowed positions. We did not simply erase the old quarter assigned to C.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 46,
      "planned_scene": 46,
      "duration_seconds": 8,
      "text": "If we erased that old weight without normalizing again, the remaining weights would total three quarters rather than one.",
      "claims": [
        "C011",
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 47,
      "planned_scene": 47,
      "duration_seconds": 8,
      "text": "Using the new weights, A contributes four thirds to the first coordinate. B contributes four thirds to the second.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 48,
      "planned_scene": 48,
      "duration_seconds": 8,
      "text": "The masked example therefore produces four thirds, four thirds. Both its weights and its result are shown as exact fractions.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 49,
      "planned_scene": 49,
      "duration_seconds": 8,
      "text": "These are two versions of an invented calculation, not an experiment showing that masking improves a trained model's performance.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 50,
      "planned_scene": 50,
      "duration_seconds": 8,
      "text": "What you can inspect is the operation: the allowed positions changed, the normalization changed, and the weighted sum changed.",
      "claims": [
        "C013"
      ],
      "visual_claims": [
        "C012"
      ]
    },
    {
      "cue": 51,
      "planned_scene": 51,
      "duration_seconds": 8,
      "text": "Before leaving the diagram, put the operation back in context. This small calculation does not represent the whole original architecture.",
      "claims": [
        "C002",
        "C008"
      ],
      "visual_claims": []
    },
    {
      "cue": 52,
      "planned_scene": 52,
      "duration_seconds": 8,
      "text": "Multi-head attention joins projected head outputs and projects their concatenation. Our single-query illustration leaves that larger structure out.",
      "claims": [
        "C004"
      ],
      "visual_claims": []
    },
    {
      "cue": 53,
      "planned_scene": 53,
      "duration_seconds": 8,
      "text": "Avoid giving a head a permanent human-like job based on a decorative illustration. This episode has not measured such a job.",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 54,
      "planned_scene": 54,
      "duration_seconds": 8,
      "text": "The original design also adds positional encodings to input embeddings. Keep this architectural step separate from our supplied toy inputs.",
      "claims": [
        "C007"
      ],
      "visual_claims": []
    },
    {
      "cue": 55,
      "planned_scene": 55,
      "duration_seconds": 8,
      "text": "Feed-forward sublayers, residual connections, and normalization also belong to the architecture. An attention-only picture needs that visible boundary.",
      "claims": [
        "C008"
      ],
      "visual_claims": []
    },
    {
      "cue": 56,
      "planned_scene": 56,
      "duration_seconds": 8,
      "text": "A simplified drawing is useful when you can identify both the operation it shows and the parts it leaves out.",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 57,
      "planned_scene": 57,
      "duration_seconds": 8,
      "text": "Remember the three attention settings. Their different places in the architecture help you keep the described operations distinct.",
      "claims": [
        "C005"
      ],
      "visual_claims": []
    },
    {
      "cue": 58,
      "planned_scene": 58,
      "duration_seconds": 8,
      "text": "Return to the full diagram with the same labels. Keep the historical system identified throughout the architecture explanation.",
      "claims": [
        "C002"
      ],
      "visual_claims": []
    },
    {
      "cue": 59,
      "planned_scene": 59,
      "duration_seconds": 8,
      "text": "The explanation remains about a selected design and a selected operation. It is not a specification for every product using AI.",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 60,
      "planned_scene": 60,
      "duration_seconds": 8,
      "text": "That prepares the final question: even with the mechanism visible, what would justify treating its attention weights as an explanation?",
      "claims": [
        "C009",
        "C010"
      ],
      "visual_claims": []
    },
    {
      "cue": 61,
      "planned_scene": 61,
      "duration_seconds": 8,
      "text": "Jain and Wallace investigated that question in studied attention-based NLP models. Their model scope must travel with their reported result.",
      "claims": [
        "C009"
      ],
      "visual_claims": []
    },
    {
      "cue": 62,
      "planned_scene": 62,
      "duration_seconds": 8,
      "text": "They found substantially different attention distributions that could accompany similar predictions. Their finding concerns the systems studied in their experiments.",
      "claims": [
        "C009"
      ],
      "visual_claims": []
    },
    {
      "cue": 63,
      "planned_scene": 63,
      "duration_seconds": 8,
      "text": "Our invented arithmetic does not reproduce that experiment. It cannot independently confirm or refute their conclusions about model explanations.",
      "claims": [
        "C009",
        "C011",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 64,
      "planned_scene": 64,
      "duration_seconds": 8,
      "text": "Wiegreffe and Pinter argued that assessing attention as explanation depends on a definition of explanation and model-aware testing.",
      "claims": [
        "C010"
      ],
      "visual_claims": []
    },
    {
      "cue": 65,
      "planned_scene": 65,
      "duration_seconds": 8,
      "text": "That response asks us to define what would count as an explanation before deciding how to test it.",
      "claims": [
        "C010"
      ],
      "visual_claims": []
    },
    {
      "cue": 66,
      "planned_scene": 66,
      "duration_seconds": 8,
      "text": "Read the two positions together. Ask which model, which prediction, and which criterion of explanation each discussion concerns.",
      "claims": [
        "C009",
        "C010"
      ],
      "visual_claims": []
    },
    {
      "cue": 67,
      "planned_scene": 67,
      "duration_seconds": 8,
      "text": "Neither title should become a universal slogan about every attention head. Keep the claim as narrow as the evidence inspected here.",
      "claims": [
        "C009",
        "C010"
      ],
      "visual_claims": []
    },
    {
      "cue": 68,
      "planned_scene": 68,
      "duration_seconds": 8,
      "text": "A bright heatmap can invite a story. Before accepting that story, ask what test connects the diagram to the interpretation.",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 69,
      "planned_scene": 69,
      "duration_seconds": 8,
      "text": "For this episode, the result is a careful question rather than a claim that a mathematical picture reveals human-like thought.",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 70,
      "planned_scene": 70,
      "duration_seconds": 8,
      "text": "We can describe an operation, check an example, and still require further evidence before making a claim about a model's reasoning.",
      "claims": [
        "C009",
        "C010",
        "C012"
      ],
      "visual_claims": []
    },
    {
      "cue": 71,
      "planned_scene": 71,
      "duration_seconds": 8,
      "text": "Ask three questions of the next diagram: what system is shown, what quantity appears, and what evidence supports its meaning?",
      "claims": [],
      "visual_claims": []
    },
    {
      "cue": 72,
      "planned_scene": 72,
      "duration_seconds": 8,
      "text": "Keep the synthetic label on invented examples. Keep the source and its limits with any result reported by a study.",
      "claims": [
        "C009",
        "C010",
        "C011"
      ],
      "visual_claims": []
    },
    {
      "cue": 73,
      "planned_scene": 73,
      "duration_seconds": 8,
      "text": "Our arithmetic showed supplied weights combining supplied values. It did not measure a trained model's understanding or settle the explanation debate.",
      "claims": [
        "C011",
        "C012",
        "C013"
      ],
      "visual_claims": []
    },
    {
      "cue": 74,
      "planned_scene": 74,
      "duration_seconds": 8,
      "text": "The source links let you inspect the historical design and both research positions. Follow them when you want the precise context.",
      "claims": [
        "C001",
        "C009",
        "C010"
      ],
      "visual_claims": []
    },
    {
      "cue": 75,
      "planned_scene": 75,
      "duration_seconds": 8,
      "text": "Understanding the steps is useful. Knowing exactly where those steps stop supporting a conclusion is part of understanding them well.",
      "claims": [],
      "visual_claims": []
    }
  ],
